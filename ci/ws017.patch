diff -ruN '--exclude=bin' '--exclude=build' '--exclude=BUILD_INFO.txt' '--exclude=README.md' '--exclude=README_ru.md' a/tests/test_framebuffer.c b/tests/test_framebuffer.c
--- a/tests/test_framebuffer.c	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_framebuffer.c	2026-09-08 17:55:19.912334309 +0000
@@ -0,0 +1,53 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include "framebuffer.h"
+
+int main(void) {
+    uint8_t storage[128];
+    ad5x_framebuffer fb;
+    memset(&fb, 0, sizeof(fb));
+    fb.mapped = storage;
+    fb.mapped_ok = 1;
+    fb.map_size = sizeof(storage);
+    fb.width = 4;
+    fb.height = 2;
+    fb.bpp = 32;
+    fb.stride = 24;
+    fb.xoffset = 1;
+    fb.yoffset = 1;
+
+    const uint8_t *p = ad5x_framebuffer_visible_ptr(&fb);
+    assert(p == storage + 24 + 4);
+
+    fb.mapped_ok = 0;
+    assert(ad5x_framebuffer_visible_ptr(&fb) == NULL);
+
+    const char *path = "/tmp/ad5x-fb-test.bin";
+    int fd = open(path, O_CREAT | O_TRUNC | O_RDWR, 0600);
+    assert(fd >= 0);
+    unlink(path);
+    uint8_t filedata[48];
+    for (size_t i = 0; i < sizeof(filedata); ++i) filedata[i] = (uint8_t)i;
+    assert(write(fd, filedata, sizeof(filedata)) == (ssize_t)sizeof(filedata));
+
+    memset(&fb, 0, sizeof(fb));
+    fb.fd = fd;
+    fb.width = 4;
+    fb.height = 2;
+    fb.bpp = 32;
+    fb.stride = 24;
+    fb.copy_size = sizeof(filedata);
+    assert(ad5x_framebuffer_capture(&fb) == 0);
+    assert(fb.copy != NULL);
+    assert(memcmp(fb.copy, filedata, sizeof(filedata)) == 0);
+    free(fb.copy);
+    close(fd);
+
+    puts("test_framebuffer: ok");
+    return 0;
+}
